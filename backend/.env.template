# .env
# Environment variables for Aetherstore Engine

# Application settings
APP_NAME=Aetherstore Engine
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Database settings
DATABASE_URL=postgresql://localhost/aetherstore_dev
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Security settings
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS settings
CORS_ORIGINS=*
CORS_CREDENTIALS=True
CORS_METHODS=*
CORS_HEADERS=*

# File storage settings
UPLOAD_DIR=uploads
TEMP_DIR=temp
MAX_FILE_SIZE_MB=50

# AI service settings
AI_SERVICE_URL=http://localhost:8001
AI_MODEL_TIMEOUT_SECONDS=300

# WebSocket settings
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8002

# Redis settings
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=3600

# Logging settings
LOG_LEVEL=INFO
LOG_FILE=app.log

# Analytics settings
ANALYTICS_BATCH_SIZE=50
ANALYTICS_FLUSH_INTERVAL_SECONDS=30