# .env.example
# Aetherstore Engine Environment Configuration

# --- Basic Settings ---
APP_NAME=Aetherstore Engine
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production
# Sentry DSN for error monitoring
SENTRY_DSN=

# --- Database Settings ---
# In production, use a managed database (RDS, Cloud SQL, etc.)
DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# --- Security Settings ---
# Use a long, random string for SECRET_KEY. Keep it secret!
SECRET_KEY=generate-a-secure-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=60

# --- CORS Settings ---
# Restrict this to your specific frontend domains in production
CORS_ORIGINS=https://yourstore.com,https://admin.yourstore.com
CORS_CREDENTIALS=True
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# --- Payment Gateways (Platform Subscriptions) ---
# Your own Stripe keys for collecting platform fees
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Paystack keys for platform fees
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...

# --- Email Service ---
EMAIL_PROVIDER=sendgrid # sendgrid, mailgun, or smtp
EMAIL_SENDGRID_API_KEY=
FROM_EMAIL=noreply@aetherstore.engine
FROM_NAME=Aetherstore Engine

# --- AI & Processing ---
AI_SERVICE_URL=http://localhost:8001
AI_MODEL_TIMEOUT_SECONDS=300

# --- Caching ---
# Redis is recommended for production
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=3600

# --- Logging ---
LOG_LEVEL=WARNING
LOG_FILE=logs/app.log
