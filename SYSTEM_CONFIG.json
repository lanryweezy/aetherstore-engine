# Aetherstore Engine - Complete System Configuration
# This file contains all configuration for the 3D fashion platform

{
  "aetherstore_engine": {
    "version": "1.0.0",
    "name": "Aetherstore Engine",
    "description": "The Ultimate 3D Fashion Platform for the Next 20 Years",
    "build_date": "2024-01-15",
    "status": "ready_for_deployment"
  },
  
  "servers": {
    "backend": {
      "host": "0.0.0.0",
      "port": 8000,
      "workers": 1,
      "reload": false,
      "log_level": "info"
    },
    "frontend": {
      "host": "0.0.0.0", 
      "port": 3000,
      "static_dir": "../frontend",
      "cache_control": "max-age=3600"
    }
  },
  
  "database": {
    "type": "postgresql",
    "host": "localhost",
    "port": 5432,
    "name": "aetherstore",
    "username": "aetherstore_user",
    "password_env": "AETHERSTORE_DB_PASSWORD",
    "pool_size": 20,
    "max_overflow": 30
  },
  
  "ai_services": {
    "computer_vision": {
      "enabled": true,
      "model_path": "models/cv_model.pth",
      "confidence_threshold": 0.8,
      "max_image_size": "10MB"
    },
    "recommendation_engine": {
      "enabled": true,
      "algorithm": "hybrid_collaborative_content_deep_learning",
      "update_frequency_minutes": 60,
      "max_recommendations": 20
    },
    "fit_analysis": {
      "enabled": true,
      "accuracy_threshold": 0.85,
      "body_measurement_precision_cm": 0.5
    },
    "style_analysis": {
      "enabled": true,
      "style_categories": ["casual", "formal", "sporty", "elegant", "trendy"],
      "body_type_classifications": ["hourglass", "pear", "apple", "rectangle"]
    }
  },
  
  "3d_rendering": {
    "engine": "threejs_with_aframe_fallback",
    "max_poly_count": 50000,
    "texture_resolution": "4k",
    "lighting_quality": "high",
    "shadow_quality": "soft",
    "fps_target": 60,
    "vr_support": true,
    "ar_support": true
  },
  
  "user_features": {
    "avatar_scanning": {
      "enabled": true,
      "min_photos_for_accuracy": 3,
      "processing_time_limit_seconds": 30,
      "privacy_mode": true
    },
    "virtual_try_on": {
      "enabled": true,
      "physics_simulation": true,
      "real_time_rendering": true,
      "pose_variations": ["standing", "walking", "sitting", "turning"]
    },
    "size_recommendation": {
      "enabled": true,
      "confidence_threshold": 0.7,
      "alternative_suggestions": true
    }
  },
  
  "store_features": {
    "templates": ["modern-gallery", "vintage-loft", "luxury-palace", "futuristic-showroom"],
    "customization": {
      "color_themes": true,
      "lighting_control": true,
      "layout_customization": true,
      "brand_integration": true
    },
    "analytics": {
      "real_time_tracking": true,
      "heatmap_generation": true,
      "conversion_analysis": true,
      "user_behavior_insights": true
    }
  },
  
  "commerce": {
    "payment_gateways": ["stripe", "paypal", "paystack"],
    "currencies": ["USD", "EUR", "GBP", "NGN"],
    "shipping_integration": true,
    "inventory_management": true,
    "order_tracking": true
  },
  
  "security": {
    "jwt_secret_env": "AETHERSTORE_JWT_SECRET",
    "encryption": "aes-256",
    "gdpr_compliant": true,
    "data_retention_days": 365,
    "secure_file_upload": true,
    "rate_limiting": {
      "requests_per_minute": 100,
      "burst_limit": 200
    }
  },
  
  "performance": {
    "caching": {
      "enabled": true,
      "redis_host": "localhost",
      "redis_port": 6379,
      "ttl_seconds": 3600
    },
    "cdn": {
      "enabled": true,
      "provider": "cloudflare",
      "asset_caching": true
    },
    "image_optimization": {
      "enabled": true,
      "formats": ["webp", "jpeg", "png"],
      "sizes": ["thumbnail", "medium", "large", "original"]
    }
  },
  
  "integrations": {
    "third_party": {
      "analytics": ["google_analytics", "mixpanel"],
      "crm": ["salesforce", "hubspot"],
      "marketing": ["mailchimp", "klaviyo"]
    },
    "social_features": {
      "social_login": ["google", "facebook", "apple"],
      "social_sharing": true,
      "influencer_integration": true
    }
  },
  
  "monitoring": {
    "logging": {
      "level": "info",
      "format": "json",
      "file_size_limit": "10MB",
      "retention_days": 30
    },
    "health_checks": {
      "enabled": true,
      "endpoint": "/api/health",
      "monitoring_interval_seconds": 30
    },
    "error_tracking": {
      "enabled": true,
      "service": "built_in",
      "alert_threshold": 5
    }
  },
  
  "development": {
    "debug_mode": false,
    "cors_origins": ["*"],
    "test_data_generation": true,
    "api_docs_enabled": true,
    "development_tools": {
      "postman_collection": true,
      "api_testing": true,
      "performance_testing": true
    }
  },
  
  "deployment": {
    "containerization": {
      "dockerfile_path": "./Dockerfile",
      "docker_compose_path": "./docker-compose.yml",
      "image_tag": "aetherstore:latest"
    },
    "environment": {
      "production": {
        "server_scaling": "auto",
        "cdn_distribution": true,
        "backup_frequency": "daily",
        "monitoring": "full"
      },
      "staging": {
        "server_scaling": "manual",
        "monitoring": "essential",
        "feature_flags": ["beta_features"]
      },
      "development": {
        "auto_reload": true,
        "detailed_logging": true,
        "feature_flags": ["experimental_features"]
      }
    }
  },
  
  "feature_flags": {
    "3d_try_on": true,
    "ai_recommendations": true,
    "avatar_scanning": true,
    "vr_mode": false,
    "ar_mode": true,
    "social_shopping": false,
    "voice_control": false,
    "haptic_feedback": false
  },
  
  "dependencies": {
    "python": ">=3.8",
    "node": ">=16.0",
    "required_packages": [
      "fastapi",
      "uvicorn", 
      "sqlalchemy",
      "pydantic",
      "opencv-python",
      "mediapipe",
      "tensorflow",
      "torch",
      "scikit-learn",
      "pandas",
      "numpy",
      "requests",
      "aiofiles"
    ]
  }
}